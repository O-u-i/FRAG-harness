# Fake providers make no external calls and need no credentials.
FRAG_CONTEXT_LLM_PROVIDER=fake
FRAG_CONTEXT_LLM_MODEL=fake-context-v1
FRAG_INFERENCE_LLM_PROVIDER=fake
FRAG_INFERENCE_LLM_MODEL=fake-inference-v1
FRAG_LLM_TIMEOUT_SECONDS=120

# Optional OpenAI stages: configure each provider/model and a backend-only key.
# FRAG_CONTEXT_LLM_PROVIDER=openai
# FRAG_CONTEXT_LLM_MODEL=gpt-5-mini
# FRAG_INFERENCE_LLM_PROVIDER=openai
# FRAG_INFERENCE_LLM_MODEL=gpt-5-mini
# OPENAI_API_KEY=<backend-only-key>

# Optional local Ollama route for either stage.
# FRAG_CONTEXT_LLM_PROVIDER=ollama
# FRAG_CONTEXT_LLM_MODEL=qwen3:8b
# FRAG_CONTEXT_LLM_BASE_URL=http://127.0.0.1:11434/v1/
