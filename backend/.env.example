# Fake providers make no external calls and need no credentials.
FRAG_CONTEXT_LLM_PROVIDER=fake
FRAG_CONTEXT_LLM_MODEL=fake-context-v1
FRAG_INFERENCE_LLM_PROVIDER=fake
FRAG_INFERENCE_LLM_MODEL=fake-inference-v1
FRAG_LLM_TIMEOUT_SECONDS=120

# Optional OpenAI stages: configure each provider/model and a backend-only key.
# FRAG_CONTEXT_LLM_PROVIDER=openai
# FRAG_CONTEXT_LLM_MODEL=gpt-4.1-mini
# FRAG_INFERENCE_LLM_PROVIDER=openai
# FRAG_INFERENCE_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=<backend-only-key>

# Optional reviewed Pi adapter. Enable all three stages for synthetic acceptance.
# FRAG_CONTEXT_LLM_ADAPTER=pi
# FRAG_INFERENCE_LLM_ADAPTER=pi
# FRAG_RESEARCH_LLM_PROVIDER=openai
# FRAG_RESEARCH_LLM_MODEL=gpt-4.1-mini
# FRAG_RESEARCH_LLM_ADAPTER=pi
# Supports GPT-4.1 mini/nano/full and their 2025-04-14 snapshots, plus gpt-6.1-sol.
# Sol freezes low reasoning and encrypted replay within the same output limits.
# Configure the exact HTTPS /v1 base separately for each stage when using a relay.
# Confirm relay Responses, streaming, strict schemas and tool/reasoning replay support first.
# FRAG_CONTEXT_LLM_BASE_URL=https://api.openai.com/v1/
# FRAG_INFERENCE_LLM_BASE_URL=https://api.openai.com/v1/
# FRAG_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1/
# The configured endpoint is previewed and frozen; redirects/proxies/retries stay disabled.

# Optional local Ollama route for either stage.
# FRAG_CONTEXT_LLM_PROVIDER=ollama
# FRAG_CONTEXT_LLM_MODEL=qwen3:8b
# FRAG_CONTEXT_LLM_BASE_URL=http://127.0.0.1:11434/v1/
