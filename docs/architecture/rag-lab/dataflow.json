    { "label": "Index and query" },
    { "label": "Retrieve" },
    { "label": "Preview" }
  ],
  "nodes": [
    { "id": "buildAction", "type": "frontend", "label": "Explicit Build", "stage": 0, "row": 0 },
    { "id": "selectedSource", "type": "database", "label": "Selected snapshot", "stage": 0, "row": 2 },
    { "id": "sectionChunking", "type": "backend", "label": "Title-aware split", "stage": 1, "row": 1 },
    { "id": "query", "type": "frontend", "label": "RAG Lab query", "stage": 2, "row": 0 },
    { "id": "ftsIndex", "type": "database", "label": "Child FTS + parent", "stage": 2, "row": 2 },
    { "id": "search", "type": "backend", "label": "Rank + expand", "stage": 3, "row": 1 },
    { "id": "contextPreview", "type": "security", "label": "Parent preview", "stage": 4, "row": 1 }
  ],
  "flows": [
    { "id": "buildRequest", "from": "buildAction", "to": "sectionChunking", "label": "selected scope + rebuild", "variant": "emphasis" },
    { "id": "sourceSections", "from": "selectedSource", "to": "sectionChunking", "label": "sections + source hash", "variant": "default" },
    { "id": "indexedChunks", "from": "sectionChunking", "to": "ftsIndex", "label": "child + parent IDs", "variant": "emphasis" },
    { "id": "queryTerms", "from": "query", "to": "search", "label": "query + topK", "variant": "default" },
    { "id": "rankedRows", "from": "ftsIndex", "to": "search", "label": "ranked child + parent", "variant": "emphasis" },
    { "id": "candidateEvidence", "from": "search", "to": "contextPreview", "label": "bounded parent evidence", "variant": "security", "labelAt": [853, 314] }
  ],
  "cards": [
    { "dot": "emerald", "title": "Index boundary", "items": [
      "Explicit Build uses the bundled synthetic corpus or one selected local file and its allowed locators in an isolated cache.",
      "Queries never rebuild; unselected sections stay outside expansion. Reviewed memory remains in the separate Run database."
    ] },
    { "dot": "amber", "title": "Retrieval boundary", "items": [
      "Search ranks child retrieval chunkId values; Preview deduplicates parent sections and bounds long hits.",
      "Preview binds source scope, bytes, index revision and confirmed memory versions; no model call or automatic memory selection."
    ] }
  ]
}
