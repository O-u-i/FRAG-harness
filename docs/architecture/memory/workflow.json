{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "FRAG Reviewed Memory to Approved Request",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "curation", "label": "Human curation" },
    { "id": "selection", "label": "Current selected source scope" },
    { "id": "execution", "label": "Each Research, Context or Inference request" }
  ],
  "mainPath": ["savedOutput", "candidate", "humanReview", "activeVersion", "recommendation", "confirmation", "preparedRequest", "approvedDispatch"],
  "nodes": [
    { "id": "savedOutput", "lane": "curation", "col": 0, "type": "database", "label": "Saved Run output", "sublabel": "original / human revision", "width": 160 },
    { "id": "candidate", "lane": "curation", "col": 1, "type": "frontend", "label": "Edit candidate", "sublabel": "Run + source scope", "width": 160 },
    { "id": "humanReview", "lane": "curation", "col": 2, "type": "security", "label": "Review and promote", "sublabel": "explicit review + note", "width": 160 },
    { "id": "activeVersion", "lane": "curation", "col": 3, "type": "database", "label": "Active version", "sublabel": "private runtime SQLite", "width": 160 },
    { "id": "recommendation", "lane": "selection", "col": 3, "type": "backend", "label": "Filter then FTS5", "sublabel": "max 3 applicable records", "width": 160 },
    { "id": "confirmation", "lane": "selection", "col": 4, "type": "frontend", "label": "Confirm memory", "sublabel": "pin IDs and versions", "width": 160 },
    { "id": "preparedRequest", "lane": "execution", "col": 4, "type": "security", "label": "Fresh exact preview", "sublabel": "memory + evidence", "width": 160 },
    { "id": "approvedDispatch", "lane": "execution", "col": 5, "type": "security", "label": "Approve and claim", "sublabel": "check versions before call", "width": 160 },
    { "id": "invalidVersion", "lane": "selection", "col": 5, "type": "security", "label": "Reject stale request", "sublabel": "reselect + new preview", "width": 160 }
  ],
  "edges": [
    { "from": "savedOutput", "to": "candidate" },
    { "from": "candidate", "to": "humanReview" },
    { "from": "humanReview", "to": "activeVersion", "variant": "security" },
    { "from": "activeVersion", "to": "recommendation" },
    { "from": "recommendation", "to": "confirmation" },
    { "from": "confirmation", "to": "preparedRequest", "variant": "security" },
    { "from": "preparedRequest", "to": "approvedDispatch", "variant": "security" },
    { "from": "approvedDispatch", "to": "invalidVersion", "label": "changed", "role": "error", "variant": "security" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Reviewed background", "items": [
      "Candidates, retired records and known conflicts are excluded; source and FC Workspace identities isolate reuse.",
      "General experience needs explicit human marking and promotion; memory never grants access or citation IDs."
    ] },
    { "dot": "rose", "title": "Version and approval", "items": [
      "Editing, promotion, conflict changes and retirement append versions; history and original model output remain intact.",
      "Each model request needs fresh one-use approval; memory versions are checked inside the durable claim transaction."
    ] }
  ]
}
