{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "FRAG Read-Only Plugin Integration",
    "locale": "en",
    "animation": "none",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "package",
      "label": "Pinned package and host activation"
    },
    {
      "id": "evidence",
      "label": "Explicit source selection and contract validation"
    },
    {
      "id": "model",
      "label": "Governed model stages and human review"
    }
  ],
  "mainPath": [
    "archive",
    "check",
    "load",
    "select",
    "read",
    "bind",
    "preview",
    "answer"
  ],
  "nodes": [
    {
      "id": "archive",
      "lane": "package",
      "col": 0,
      "type": "external",
      "label": "Pinned archive",
      "sublabel": "KB / optional FC",
      "width": 160
    },
    {
      "id": "check",
      "lane": "package",
      "col": 1,
      "type": "security",
      "label": "Validate package",
      "sublabel": "hash + compatibility",
      "width": 160
    },
    {
      "id": "load",
      "lane": "package",
      "col": 2,
      "type": "backend",
      "label": "Restart and load",
      "sublabel": "enabled read-only plugin",
      "width": 160
    },
    {
      "id": "select",
      "lane": "evidence",
      "col": 2,
      "type": "frontend",
      "label": "Select source scope",
      "sublabel": "file or Workspace + IDs",
      "width": 160
    },
    {
      "id": "read",
      "lane": "evidence",
      "col": 3,
      "type": "backend",
      "label": "Read selected records",
      "sublabel": "one shared contract",
      "width": 160
    },
    {
      "id": "bind",
      "lane": "evidence",
      "col": 4,
      "type": "security",
      "label": "Validate and bind",
      "sublabel": "scope + revision + digest",
      "width": 160
    },
    {
      "id": "preview",
      "lane": "model",
      "col": 4,
      "type": "security",
      "label": "Exact outbound preview",
      "sublabel": "evidence + chosen memory",
      "width": 160
    },
    {
      "id": "answer",
      "lane": "model",
      "col": 5,
      "type": "frontend",
      "label": "Approve each stage",
      "sublabel": "Context / Inference + review",
      "width": 160
    },
    {
      "id": "hidden",
      "lane": "evidence",
      "col": 1,
      "type": "security",
      "label": "No routes or UI",
      "sublabel": "invalid or disabled",
      "width": 160
    }
  ],
  "edges": [
    {
      "from": "archive",
      "to": "check"
    },
    {
      "from": "check",
      "to": "load"
    },
    {
      "from": "load",
      "to": "select"
    },
    {
      "from": "select",
      "to": "read"
    },
    {
      "from": "read",
      "to": "bind"
    },
    {
      "from": "bind",
      "to": "preview"
    },
    {
      "from": "preview",
      "to": "answer"
    },
    {
      "from": "check",
      "to": "hidden",
      "role": "error",
      "variant": "security",
      "label": "reject"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Host boundaries",
      "items": [
        "Protocol 2 binds plugin, scope and exact record IDs; protocol 1 Finance Core remains compatible.",
        "Disabled or invalid packages expose no source reader, routes or UI. Package changes invalidate approvals."
      ]
    },
    {
      "dot": "emerald",
      "title": "Separate source ownership",
      "items": [
        "KB reuses the selected file snapshot parser. FC reads Released HTTP records; finance storage and writes stay in FC.",
        "FRAG starts without FC. Plugin evidence uses the fixed two-stage flow; local KB Research remains separately bounded."
      ]
    }
  ]
}
